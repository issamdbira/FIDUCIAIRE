{
  "framework": null,
  "buildCommand": "npx prisma generate && pnpm run build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "^/(?!.*\\.).*$", "dest": "/index.html" }
  ]
}
