{
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": ".vercel/output/static",
  "installCommand": "pnpm install",
  "framework": null,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "^/(?!.*\\.).*$", "dest": "/index.html" }
  ]
}
